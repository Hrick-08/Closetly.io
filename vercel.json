
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": "backend/",
      "framework": "express",
      "entrypoint": "src/app.js"
    }
  },
  "rewrites": [
    {
      "source": "/api-docs",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api-docs/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api-docs.json",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
